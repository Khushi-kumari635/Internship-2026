# Copy this file to ".env" and update values as needed

# MongoDB connection string
# For local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/alumni_network

# For MongoDB Atlas (cloud), it looks like:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/alumni_network

# Port for the backend server
PORT=5000

# Secret key used to sign JWT tokens (change this to any random string)
JWT_SECRET=alumni_network_secret_key_2024

# Token expiry time
JWT_EXPIRES_IN=7d
